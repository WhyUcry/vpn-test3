{
    email admin@dudonya.online
}

dudonya.online {
    # API and webhook endpoints - proxy to backend
    handle /sub/* {
        reverse_proxy backend:8000
    }

    handle /webhook/* {
        reverse_proxy backend:8000
    }

    handle /health {
        reverse_proxy backend:8000
    }

    # Serve landing page for all other requests
    handle {
        root * /srv/landing
        file_server
        try_files {path} /index.html
    }

    # Logs
    log {
        output file /data/access.log
        format json
    }

    # TLS (automatic Let's Encrypt)
    tls {
        protocols tls1.2 tls1.3
    }
}
